  "private": true,
  "scripts": {
    "dev": "ts-node -r dotenv/config src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node src/migrate.ts",
    "seed:admin": "ts-node -r dotenv/config src/scripts/seedAdmin.ts",
